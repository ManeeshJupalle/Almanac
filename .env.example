# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Google (Gmail + Calendar): path to a Desktop OAuth client JSON downloaded
# from Google Cloud Console. One client covers both APIs.
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Where the DPAPI-encrypted Google token is written (gitignored via tokens/).
GOOGLE_TOKEN_PATH=./tokens/google_token.json

# Slack app OAuth client.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the Slack app.
SLACK_REDIRECT_URI=http://localhost:8080/callback
# Where the DPAPI-encrypted Slack token is written (gitignored via tokens/).
SLACK_TOKEN_PATH=./tokens/slack_token.json
# Phase 2.0: channel id (e.g. C0XXXXXXX) of a PRIVATE test channel you are a
# member of — the target for SlackPostExecutor live checks and the slack-post
# payload capture. Leave blank until you run the Phase 2.0 live gate.
SLACK_TEST_CHANNEL=

# Where redacted fixtures are written.
FIXTURES_DIR=./fixtures
