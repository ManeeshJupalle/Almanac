# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Google (Gmail + Calendar): path to a Desktop OAuth client JSON downloaded
# from Google Cloud Console. One client covers both APIs.
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Where the DPAPI-encrypted Google token is written (gitignored via tokens/).
GOOGLE_TOKEN_PATH=./tokens/google_token.json

# Slack app OAuth client.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the Slack app.
SLACK_REDIRECT_URI=http://localhost:8080/callback
# Where the DPAPI-encrypted Slack token is written (gitignored via tokens/).
SLACK_TOKEN_PATH=./tokens/slack_token.json
# Phase 2.0: channel id (e.g. C0XXXXXXX) of a PRIVATE test channel you are a
# member of — the target for SlackPostExecutor live checks and the slack-post
# payload capture. Leave blank until you run the Phase 2.0 live gate.
SLACK_TEST_CHANNEL=

# Jira (Atlassian Cloud) — Phase 2.1. Basic auth (email + API token). The token
# is validated by `jira-auth` and then stored DPAPI-encrypted at JIRA_TOKEN_PATH
# (tokens/, gitignored); JIRA_API_TOKEN is only the one-time bootstrap and may be
# blanked afterward. A2: these are read only by JiraAuth, never by Gmail/Slack.
JIRA_BASE_URL=https://YOURSITE.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_TOKEN_PATH=./tokens/jira_token.json
# Optional: restrict the read window to one project key (e.g. ALM). Blank = all.
JIRA_PROJECT=

# GitWatcher (Phase 2.2) — semicolon-separated absolute paths to local git
# repos to watch for commit evidence. A2: this is read ONLY by the GitWatcher,
# which shells out to `git` locally and holds NO network credential — it cannot
# reach Gmail/Slack/Jira tokens, and they cannot reach it. `git` must be on PATH.
ALMANAC_GIT_REPOS=D:/alm-scratch;D:/Almanac

# Where redacted fixtures are written.
FIXTURES_DIR=./fixtures
